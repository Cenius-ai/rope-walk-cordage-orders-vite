# Rope Walk Cordage Orders — environment template.
# Copy to backend/.env only if you want to override the development defaults.
# The service boots with no .env file at all.

# Session signing key. The in-code development fallback is
# cenius-dev-8f42c1d9b6a35e07; install.sh writes a random value here.
JWT_SECRET=cenius-dev-8f42c1d9b6a35e07

# Minutes a bearer token stays valid (default 720 = 12 hours).
JWT_EXPIRES_MINUTES=720

# Relative SQLite file. Leave commented to use backend/ropewalk.db.
# DATABASE_URL=sqlite:///./ropewalk.db

# Comma-separated origins allowed to call the API directly (the Vite proxy is
# same-origin, so this only matters for direct :8000 requests).
CORS_ORIGINS=*
